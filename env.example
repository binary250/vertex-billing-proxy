# Copy this to .env for local testing with `vercel dev`.
# In production, set these as Environment Variables in the Vercel dashboard —
# never commit a real .env file.

# From Razorpay Dashboard → Settings → API Keys
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_real_secret_here

# Any long random string YOU make up (e.g. `openssl rand -hex 32`).
# The app sends this in an `x-proxy-key` header on every request — it just
# stops random people on the internet from calling your proxy and spamming
# your Razorpay account. It is NOT your Razorpay secret.
PROXY_API_KEY=generate-a-long-random-string-here
