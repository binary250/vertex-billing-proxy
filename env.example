# Copy to .env for local testing with `vercel dev`.
# In production, set these in the Vercel dashboard — never commit a real .env.

# From Cashfree Merchant Dashboard → Developers → API Keys (Production tab, not Sandbox)
CF_CLIENT_ID=your_client_id_here
CF_CLIENT_SECRET=your_client_secret_here

# Set to "sandbox" while testing against Cashfree's test environment,
# remove or set to "production" (or just omit) once you're live.
CF_ENV=production

# Any long random string YOU make up (e.g. `openssl rand -hex 32`).
# The app sends this in an `x-proxy-key` header — stops random people on the
# internet from calling your proxy. Not a Cashfree credential.
PROXY_API_KEY=generate-a-long-random-string-here
